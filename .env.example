AI_STUDIO_API_KEY=your_ai_studio_access_token
AI_STUDIO_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
AI_STUDIO_MODEL=ernie-4.5-turbo-128k
API_HOST=127.0.0.1
API_PORT=3001

# 本机自动存档：服务启动时立即存档，之后按此间隔（小时）继续存档。
AUTO_BACKUP_INTERVAL_HOURS=6
# 保留最近的自动存档份数；旧快照会从 backups/ 自动清理。
AUTO_BACKUP_RETENTION_COUNT=14

# 私人 Tailscale 部署继续从本机 .env 读取密钥，不要把真实值提交到仓库。
# API_HOST 保持 127.0.0.1；Tailscale Serve 会安全代理这个本机端口。
